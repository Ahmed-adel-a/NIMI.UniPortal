<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared build settings for every project under backend/.
  Single TFM + nullable + implicit usings live here so project files stay empty.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
