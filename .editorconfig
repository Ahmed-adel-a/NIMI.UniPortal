root = true

# ---------------------------------------------------------------------------
#  Backend (.NET) — kept minimal on purpose.
#  Fine-grained style rules (dotnet_diagnostic_*) arrive with the P0 slices.
# ---------------------------------------------------------------------------

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,json,yml,yaml}]
indent_size = 2
