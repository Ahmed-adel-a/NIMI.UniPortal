    same code: the SemesterBased lifecycle (P4.B) instead of CreditHours, and Library instead of Forum and Events.
  -->

  <PropertyGroup>
    <UserSecretsId>nimi-uniportal-host-ainshams</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared plumbing + the core modules + dashboards (every deployment). -->
    <ProjectReference Include="..\NIMI.UniPortal.Hosting\NIMI.UniPortal.Hosting.csproj" />
    <!-- Decision LIFECYCLE: exactly one lifecycle variant: SemesterBased (نظام الفرق, P4.B). -->
    <ProjectReference Include="..\..\Modules\Lifecycle.SemesterBased\NIMI.UniPortal.Modules.Lifecycle.SemesterBased.Api\NIMI.UniPortal.Modules.Lifecycle.SemesterBased.Api.csproj" />
    <!-- Premium modules this deployment sells (P11): Library. -->
    <ProjectReference Include="..\..\Modules\Library\NIMI.UniPortal.Modules.Library.Api\NIMI.UniPortal.Modules.Library.Api.csproj" />
  </ItemGroup>

</Project>
